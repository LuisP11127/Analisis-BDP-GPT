{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luisp11127.github.io/Analisis-BDP-GPT/esquemas/config-casas.schema.json",
  "title": "Casas de apuestas y fuentes de datos",
  "type": "object",
  "required": ["version_formato", "casas", "fuentes"],
  "properties": {
    "version_formato": { "$ref": "comun.schema.json#/$defs/version_formato" },
    "casas": {
      "description": "En orden de prioridad para elegir la línea candidata.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["codigo", "nombre", "rol"],
        "properties": {
          "codigo": { "$ref": "comun.schema.json#/$defs/codigo" },
          "nombre": { "$ref": "comun.schema.json#/$defs/texto" },
          "rol": { "enum": ["principal", "referencia"] }
        },
        "additionalProperties": false
      }
    },
    "fuentes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["codigo", "nombre", "rol"],
        "properties": {
          "codigo": { "$ref": "comun.schema.json#/$defs/codigo" },
          "nombre": { "$ref": "comun.schema.json#/$defs/texto" },
          "rol": { "enum": ["principal", "complementaria"] }
        },
        "additionalProperties": false
      }
    },
    "nota": { "$ref": "comun.schema.json#/$defs/texto" }
  },
  "additionalProperties": false
}

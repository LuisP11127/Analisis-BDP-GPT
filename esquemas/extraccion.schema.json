{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luisp11127.github.io/Analisis-BDP-GPT/esquemas/extraccion.schema.json",
  "title": "Extracción del día",
  "description": "Lo que la extensión le entrega a la página: los partidos del día de todas las ligas y las cuotas de sus mercados. No se guarda en datos/. En ejemplos/extraccion/ hay extracciones de prueba.",
  "type": "object",
  "required": ["version_formato", "fecha_local", "generado_en", "partidos", "mercados"],
  "properties": {
    "version_formato": { "$ref": "comun.schema.json#/$defs/version_formato" },
    "fecha_local": { "$ref": "comun.schema.json#/$defs/fecha" },
    "generado_en": { "$ref": "comun.schema.json#/$defs/fecha_hora" },
    "partidos": { "type": "array", "items": { "$ref": "partido.schema.json" } },
    "mercados": { "type": "array", "items": { "$ref": "#/$defs/mercado" } }
  },
  "additionalProperties": false,
  "$defs": {
    "mercado": {
      "description": "Cuotas de un mercado de un partido en cada casa.",
      "type": "object",
      "required": ["partido_id", "mercado", "ofertas"],
      "properties": {
        "partido_id": { "$ref": "comun.schema.json#/$defs/id" },
        "mercado": { "$ref": "comun.schema.json#/$defs/codigo" },
        "jugador": { "$ref": "registro.schema.json#/properties/jugador" },
        "estadistica_jugador": { "$ref": "comun.schema.json#/$defs/codigo" },
        "ofertas": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "registro.schema.json#/$defs/oferta" }
        },
        "prediccion_ejemplo": {
          "description": "Solo en extracciones de prueba: predicciones ficticias que la página muestra mientras no exista el análisis estadístico (paso 5). La extensión nunca lo envía. estadistico null significa que no hay datos suficientes.",
          "type": "object",
          "required": ["estadistico", "red"],
          "properties": {
            "estadistico": { "anyOf": [{ "type": "null" }, { "$ref": "registro.schema.json#/$defs/prediccion" }] },
            "red": { "anyOf": [{ "type": "null" }, { "$ref": "registro.schema.json#/$defs/prediccion" }] },
            "entrada_red": { "$ref": "registro.schema.json#/properties/entrada_red" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
